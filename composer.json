{
    "name": "akibeo/kirby-csp",
    "description": "Content-Security-Policy headers with per-request nonce for Kirby, following Google's strict CSP guidance.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": ["kirby", "kirby-plugin", "csp", "content-security-policy", "security", "nonce", "strict-dynamic"],
    "homepage": "https://github.com/wdebusschere/kirby-csp",
    "authors": [
        {
            "name": "Wannes Debusschere",
            "email": "wannes@e-xperience.pt",
            "homepage": "https://e-xperience.pt"
        },
        {
            "name": "Yassine El Bouazzaoui",
            "email": "yassine@e-xperience.pt",
            "homepage": "https://e-xperience.pt"
        }
    ],
    "support": {
        "issues": "https://github.com/wdebusschere/kirby-csp/issues",
        "source": "https://github.com/wdebusschere/kirby-csp"
    },
    "require": {
        "php": ">=8.1",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Akibeo\\Csp\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Akibeo\\Csp\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
